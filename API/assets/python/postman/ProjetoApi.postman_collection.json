            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"ação\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test(\"campo resultado\", () => pm.expect(corpo).to.have.keys(\"resultado\"));",
                  "pm.test(\"X-Request-ID presente\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok);",
                  "",
                  "pm.test(\"resultado AÇÃO\", () => pm.expect(corpo.resultado).to.eql(\"AÇÃO\"));"
                ]
              }
            }
          ]
        }
