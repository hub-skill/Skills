                  "  pm.test(\"Retry-After = 60\", () => pm.expect(pm.response.headers.get(\"Retry-After\")).to.eql(\"60\"));",
                  "} else {",
                  "  pm.test(\"ainda dentro do limite (200)\", () => pm.response.to.have.status(200));",
