# API .NET (criar-api, assets/dotnet). Copie para config.env. Sem segredos aqui.
# Arrays do ASP.NET Core por variável de ambiente: Secao__Chave__0, __1...
ASPNETCORE_ENVIRONMENT=Production
Api__AllowedHosts__0=localhost
Api__AllowedHosts__1=projeto-api
Api__AllowedHosts__2=projeto-api.projeto-api.svc
Api__AllowedHosts__3=projeto-api.projeto-api.svc.cluster.local
Api__EnableDocs=false
Api__RequestTimeoutSeconds=10
# Por pod e em memória: com N réplicas o limite real é N x este valor.
Api__RateLimitPorMinuto=60
# Banco na máquina Windows (fora do cluster): host.docker.internal. Em produção, o host real do banco.
Bancos__Postgres__Host=host.docker.internal
Bancos__Postgres__Porta=5432
Bancos__Oracle__Dsn=host.docker.internal:1521/XEPDB1
