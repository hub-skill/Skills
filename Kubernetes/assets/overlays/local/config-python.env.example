# API Python (criar-api, assets/python). Copie para config.env. Sem segredos aqui.
APP_ENV=dev
# localhost: probes (header Host fixo) e port-forward. Nome do Service: chamadas de dentro do cluster.
ALLOWED_HOSTS=["localhost","projeto-api","projeto-api.projeto-api.svc","projeto-api.projeto-api.svc.cluster.local"]
ENABLE_DOCS=false
REQUEST_TIMEOUT_SECONDS=10
# Por pod e em memória: com N réplicas o limite real é N x este valor. Use Redis ou o Ingress para um limite global.
RATE_LIMIT=60/minute
# Banco na máquina Windows (fora do cluster): host.docker.internal. Em produção, o host real do banco.
PG_HOST=host.docker.internal
PG_PORT=5432
PG_SSLMODE=prefer
ORACLE_DSN=host.docker.internal:1521/XEPDB1
